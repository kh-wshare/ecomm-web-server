/// An anonymous storefront cart. Identified by an opaque bearer token whose
/// SHA-256 hash is stored here — the same scheme `CheckoutSession` uses, so a
/// shopper never needs an account. `customerId` is attached lazily (the first
/// time the shopper saves an address), which is what lets a future shopper
/// login adopt an existing anonymous cart without a migration.
///
/// Deliberately stores no prices: line items are re-priced through
/// `CartPricingService` on every read so a cart can never quote a stale price.
model Cart {
  id                String            @id @default(uuid()) @db.Uuid
  merchantId        String            @map("merchant_id") @db.Uuid
  customerId        String?           @map("customer_id") @db.Uuid
  /// The signed-in shopper this cart belongs to. Never a staff member — see
  /// `createdById`, which is the staff member who built a cart for someone.
  ownerId           String?           @map("owner_id") @db.Uuid
  /// The staff member who built this cart on a customer's behalf (a POS
  /// phone/walk-in order). Distinct from `ownerId`: conflating the two lets a
  /// staff account resolve to the customer they last served.
  createdById       String?           @map("created_by_id") @db.Uuid
  /// Set when this cart was folded into another on sign-in.
  mergedIntoCartId  String?           @map("merged_into_cart_id") @db.Uuid
  checkoutSessionId String?           @unique @map("checkout_session_id") @db.Uuid
  accessTokenHash   String            @unique @map("access_token_hash")
  status            CartStatus        @default(ACTIVE)
  sourceChannel     SalesChannel      @default(WEBSITE) @map("source_channel")
  customerName      String?           @map("customer_name")
  customerEmail     String?           @map("customer_email")
  customerPhone     String?           @map("customer_phone")
  note              String?
  shippingAddressId String?           @map("shipping_address_id") @db.Uuid
  billingAddressId  String?           @map("billing_address_id") @db.Uuid
  deliveryMethodId  String?           @map("delivery_method_id") @db.Uuid
  deliveryZoneId    String?           @map("delivery_zone_id") @db.Uuid
  expiresAt         DateTime          @map("expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner             User?             @relation("CartOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy         User?             @relation("CartCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mergedInto        Cart?             @relation("CartMerge", fields: [mergedIntoCartId], references: [id], onDelete: SetNull)
  mergedFrom        Cart[]            @relation("CartMerge")
  checkoutSession   CheckoutSession?  @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  shippingAddress   CustomerAddress?  @relation("CartShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress    CustomerAddress?  @relation("CartBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  deliveryMethod    DeliveryMethod?   @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  deliveryZone      DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items             CartItem[]
  savedAddresses    CustomerAddress[] @relation("CartSavedAddresses")

  @@index([merchantId, status, expiresAt])
  @@index([merchantId, customerId])
  @@index([ownerId, createdAt])
  @@index([createdById, createdAt])
  @@map("carts")
}

/// One cart line. `lineKey` exists because Postgres treats NULLs as distinct
/// in a unique index, so `@@unique([cartId, productId, variantId])` would not
/// actually collapse repeat adds of a simple (variantless) product. It uses
/// the same `product:<id>` / `variant:<id>` shape as `InventoryStock.stockKey`.
model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @map("cart_id") @db.Uuid
  productId String          @map("product_id") @db.Uuid
  variantId String?         @map("variant_id") @db.Uuid
  lineKey   String          @map("line_key")
  quantity  Int
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, lineKey])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

/// A reusable shopper address, scoped to one merchant's customer directory.
/// Orders never point at these rows — they carry a JSON snapshot instead, so
/// editing or deleting an address can never rewrite delivery history.
model CustomerAddress {
  id                String    @id @default(uuid()) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  /// The signed-in shopper who owns this address. Never a staff member — an
  /// address staff typed for a walk-in customer records them in `createdById`
  /// instead, so a staff account is never mistaken for the shopper.
  ownerId           String?   @map("owner_id") @db.Uuid
  createdById       String?   @map("created_by_id") @db.Uuid
  /// The cart this address was saved through, when a shopper saved it during
  /// checkout. Guest carts are linked to a customer only by a matching email
  /// or phone, which proves nothing, so they may read back only the addresses
  /// they saved themselves rather than the customer's whole book.
  cartId            String?   @map("cart_id") @db.Uuid
  label             String?
  recipientName     String    @map("recipient_name")
  phone             String?
  email             String?
  line1             String
  line2             String?
  city              String?
  province          String?
  postalCode        String?   @map("postal_code")
  country           String    @db.Char(2)
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  note              String?
  isDefaultShipping Boolean   @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean   @default(false) @map("is_default_billing")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner             User?     @relation("AddressOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy         User?     @relation("AddressCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cart              Cart?     @relation("CartSavedAddresses", fields: [cartId], references: [id], onDelete: SetNull)
  shippingCarts     Cart[]    @relation("CartShippingAddress")
  billingCarts      Cart[]    @relation("CartBillingAddress")

  @@index([merchantId, customerId, deletedAt])
  @@index([customerId, isDefaultShipping])
  @@index([ownerId, createdAt])
  @@index([cartId])
  @@map("customer_addresses")
}

/// A way the merchant gets an order to the shopper: either in-store PICKUP at
/// a branch (always free, no address needed) or DELIVERY priced by whichever
/// `DeliveryZone` matches the shipping address.
model DeliveryMethod {
  id               String               @id @default(uuid()) @db.Uuid
  merchantId       String               @map("merchant_id") @db.Uuid
  branchId         String?              @map("branch_id") @db.Uuid
  name             String
  code             String
  description      String?
  type             DeliveryMethodType   @default(DELIVERY)
  status           DeliveryMethodStatus @default(ACTIVE)
  isDefault        Boolean              @default(false) @map("is_default")
  sortOrder        Int                  @default(0) @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  merchant         Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch           MerchantBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  zones            DeliveryZone[]
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  shipments        Shipment[]

  @@unique([merchantId, code])
  @@index([merchantId, status, deletedAt])
  @@index([merchantId, sortOrder])
  @@map("delivery_methods")
}

/// A priced destination band inside a delivery method. A zone matches an
/// address when every non-empty geo list contains that part of the address;
/// `isFallback` zones match any address and are only considered once no
/// specific zone matches.
model DeliveryZone {
  id               String         @id @default(uuid()) @db.Uuid
  merchantId       String         @map("merchant_id") @db.Uuid
  deliveryMethodId String         @map("delivery_method_id") @db.Uuid
  name             String
  countries        String[]
  provinces        String[]
  cities           String[]
  postalCodes      String[]       @map("postal_codes")
  baseFee          Decimal        @default(0) @map("base_fee") @db.Decimal(12, 2)
  perItemFee       Decimal        @default(0) @map("per_item_fee") @db.Decimal(12, 2)
  freeOverSubtotal Decimal?       @map("free_over_subtotal") @db.Decimal(12, 2)
  minSubtotal      Decimal?       @map("min_subtotal") @db.Decimal(12, 2)
  maxSubtotal      Decimal?       @map("max_subtotal") @db.Decimal(12, 2)
  estimatedMinDays Int?           @map("estimated_min_days")
  estimatedMaxDays Int?           @map("estimated_max_days")
  isFallback       Boolean        @default(false) @map("is_fallback")
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  merchant         Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveryMethod   DeliveryMethod @relation(fields: [deliveryMethodId], references: [id], onDelete: Cascade)
  carts            Cart[]

  @@index([deliveryMethodId, deletedAt, sortOrder])
  @@index([merchantId])
  @@map("delivery_zones")
}

/// A physical hand-off of (some of) an order's items. An order can have more
/// than one when it ships in parts, which is why `ShipmentItem` carries
/// quantities rather than the shipment owning the order outright.
model Shipment {
  id               String          @id @default(uuid()) @db.Uuid
  merchantId       String          @map("merchant_id") @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  deliveryMethodId String?         @map("delivery_method_id") @db.Uuid
  shipmentNumber   String          @map("shipment_number")
  status           ShipmentStatus  @default(PENDING)
  carrierName      String?         @map("carrier_name")
  trackingNumber   String?         @map("tracking_number")
  trackingUrl      String?         @map("tracking_url")
  recipientName    String?         @map("recipient_name")
  phone            String?
  address          Json?
  shippingCost     Decimal?        @map("shipping_cost") @db.Decimal(12, 2)
  note             String?
  shippedAt        DateTime?       @map("shipped_at")
  deliveredAt      DateTime?       @map("delivered_at")
  cancelledAt      DateTime?       @map("cancelled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  merchant         Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryMethod   DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  items            ShipmentItem[]
  events           ShipmentEvent[]

  @@unique([merchantId, shipmentNumber])
  @@index([merchantId, status, createdAt])
  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentItem {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @map("shipment_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  quantity    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

/// Append-only tracking history for a shipment. The storefront tracking page
/// reads these rather than the shipment's current status alone.
model ShipmentEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @map("shipment_id") @db.Uuid
  status      ShipmentStatus
  message     String?
  location    String?
  occurredAt  DateTime       @default(now()) @map("occurred_at")
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}
