/// An anonymous storefront cart. Identified by an opaque bearer token whose
/// SHA-256 hash is stored here — the same scheme `CheckoutSession` uses, so a
/// shopper never needs an account. `customerId` is attached lazily (the first
/// time the shopper saves an address), which is what lets a future shopper
/// login adopt an existing anonymous cart without a migration.
///
/// Deliberately stores no prices: line items are re-priced through
/// `CartPricingService` on every read so a cart can never quote a stale price.
model Cart {
  id                String           @id @default(uuid()) @db.Uuid
  merchantId        String           @db.Uuid
  customerId        String?          @db.Uuid
  checkoutSessionId String?          @unique @db.Uuid
  accessTokenHash   String           @unique
  status            CartStatus       @default(ACTIVE)
  sourceChannel     SalesChannel     @default(WEBSITE)
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  note              String?
  shippingAddressId String?          @db.Uuid
  billingAddressId  String?          @db.Uuid
  deliveryMethodId  String?          @db.Uuid
  deliveryZoneId    String?          @db.Uuid
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  merchant          Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  shippingAddress   CustomerAddress? @relation("CartShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress    CustomerAddress? @relation("CartBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  deliveryMethod    DeliveryMethod?  @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  deliveryZone      DeliveryZone?    @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items             CartItem[]

  @@index([merchantId, status, expiresAt])
  @@index([merchantId, customerId])
  @@map("carts")
}

/// One cart line. `lineKey` exists because Postgres treats NULLs as distinct
/// in a unique index, so `@@unique([cartId, productId, variantId])` would not
/// actually collapse repeat adds of a simple (variantless) product. It uses
/// the same `product:<id>` / `variant:<id>` shape as `InventoryStock.stockKey`.
model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @db.Uuid
  productId String          @db.Uuid
  variantId String?         @db.Uuid
  lineKey   String
  quantity  Int
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, lineKey])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

/// A reusable shopper address, scoped to one merchant's customer directory.
/// Orders never point at these rows — they carry a JSON snapshot instead, so
/// editing or deleting an address can never rewrite delivery history.
model CustomerAddress {
  id                String    @id @default(uuid()) @db.Uuid
  merchantId        String    @db.Uuid
  customerId        String    @db.Uuid
  label             String?
  recipientName     String
  phone             String?
  email             String?
  line1             String
  line2             String?
  city              String?
  province          String?
  postalCode        String?
  country           String    @db.Char(2)
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  note              String?
  isDefaultShipping Boolean   @default(false)
  isDefaultBilling  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingCarts     Cart[]    @relation("CartShippingAddress")
  billingCarts      Cart[]    @relation("CartBillingAddress")

  @@index([merchantId, customerId, deletedAt])
  @@index([customerId, isDefaultShipping])
  @@map("customer_addresses")
}

/// A way the merchant gets an order to the shopper: either in-store PICKUP at
/// a branch (always free, no address needed) or DELIVERY priced by whichever
/// `DeliveryZone` matches the shipping address.
model DeliveryMethod {
  id               String               @id @default(uuid()) @db.Uuid
  merchantId       String               @db.Uuid
  branchId         String?              @db.Uuid
  name             String
  code             String
  description      String?
  type             DeliveryMethodType   @default(DELIVERY)
  status           DeliveryMethodStatus @default(ACTIVE)
  isDefault        Boolean              @default(false)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  merchant         Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch           MerchantBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  zones            DeliveryZone[]
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  shipments        Shipment[]

  @@unique([merchantId, code])
  @@index([merchantId, status, deletedAt])
  @@index([merchantId, sortOrder])
  @@map("delivery_methods")
}

/// A priced destination band inside a delivery method. A zone matches an
/// address when every non-empty geo list contains that part of the address;
/// `isFallback` zones match any address and are only considered once no
/// specific zone matches.
model DeliveryZone {
  id               String         @id @default(uuid()) @db.Uuid
  merchantId       String         @db.Uuid
  deliveryMethodId String         @db.Uuid
  name             String
  countries        String[]
  provinces        String[]
  cities           String[]
  postalCodes      String[]
  baseFee          Decimal        @default(0) @db.Decimal(12, 2)
  perItemFee       Decimal        @default(0) @db.Decimal(12, 2)
  freeOverSubtotal Decimal?       @db.Decimal(12, 2)
  minSubtotal      Decimal?       @db.Decimal(12, 2)
  maxSubtotal      Decimal?       @db.Decimal(12, 2)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  isFallback       Boolean        @default(false)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  merchant         Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveryMethod   DeliveryMethod @relation(fields: [deliveryMethodId], references: [id], onDelete: Cascade)
  carts            Cart[]

  @@index([deliveryMethodId, deletedAt, sortOrder])
  @@index([merchantId])
  @@map("delivery_zones")
}

/// A physical hand-off of (some of) an order's items. An order can have more
/// than one when it ships in parts, which is why `ShipmentItem` carries
/// quantities rather than the shipment owning the order outright.
model Shipment {
  id               String          @id @default(uuid()) @db.Uuid
  merchantId       String          @db.Uuid
  orderId          String          @db.Uuid
  deliveryMethodId String?         @db.Uuid
  shipmentNumber   String
  status           ShipmentStatus  @default(PENDING)
  carrierName      String?
  trackingNumber   String?
  trackingUrl      String?
  recipientName    String?
  phone            String?
  address          Json?
  shippingCost     Decimal?        @db.Decimal(12, 2)
  note             String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  merchant         Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryMethod   DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  items            ShipmentItem[]
  events           ShipmentEvent[]

  @@unique([merchantId, shipmentNumber])
  @@index([merchantId, status, createdAt])
  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentItem {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @db.Uuid
  orderItemId String    @db.Uuid
  quantity    Int
  createdAt   DateTime  @default(now())
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

/// Append-only tracking history for a shipment. The storefront tracking page
/// reads these rather than the shipment's current status alone.
model ShipmentEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @db.Uuid
  status      ShipmentStatus
  message     String?
  location    String?
  occurredAt  DateTime       @default(now())
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}
