generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MerchantUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MerchantBranchStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum ProductInventoryType {
  STOCKED
  NON_STOCKED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum SalesChannel {
  POS
  WEBSITE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum InventoryReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVED
  RESERVATION_RELEASED
  SOLD
  REFUND_RETURN
  MANUAL_ADJUSTMENT
}

enum CheckoutSessionStatus {
  ACTIVE
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  RESERVED
  PAID
  PROCESSING
  FULFILLED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentProviderCode {
  HMAC
  KHQR
  ABA_PAYWAY
  CASH
}

enum PaymentProviderStatus {
  ACTIVE
  INACTIVE
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  UNKNOWN
}

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum SocialPlatform {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum SocialPostStatus {
  DRAFT
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum SocialPublishStatus {
  PUBLISHED
  FAILED
}

enum PosDeviceStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum KitchenOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentRefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum DeliveryMethodType {
  PICKUP
  DELIVERY
}

enum DeliveryMethodStatus {
  ACTIVE
  INACTIVE
}

enum ShipmentStatus {
  PENDING
  READY_FOR_PICKUP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  fullName            String
  email               String?              @unique
  phone               String?
  telegramId          String?              @unique
  passwordHash        String
  status              UserStatus           @default(ACTIVE)
  platformRole        PlatformRole         @default(USER)
  mustChangePassword  Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  memberships         MerchantUser[]       @relation("MembershipUser")
  invitedMemberships  MerchantUser[]       @relation("MembershipInviter")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     MerchantInvitation[] @relation("InvitationInviter")
  auditLogs           AuditLog[]
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementCreator")
  authIdentities      AuthIdentity[]

  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  providerUserId String
  telegramId     String?  @unique
  email          String?
  phone          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Merchant {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String                 @unique
  email                 String?
  phone                 String?
  status                MerchantStatus         @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  memberships           MerchantUser[]
  roles                 Role[]
  sessions              Session[]
  invitations           MerchantInvitation[]
  auditLogs             AuditLog[]
  products              Product[]
  inventoryStocks       InventoryStock[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  theme                 MerchantTheme?
  checkoutSessions      CheckoutSession[]
  orders                Order[]
  returnStockOnRefund   Boolean                @default(true)
  paymentProviders      PaymentProvider[]
  payments              Payment[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  notifications         Notification[]
  socialPosts           SocialPost[]
  websiteArticles       WebsiteArticle[]
  branches              MerchantBranch[]
  productCategories     ProductCategory[]
  posDevices            PosDevice[]
  posShifts             PosShift[]
  posTables             PosTable[]
  customers             Customer[]
  kitchenOrders         KitchenOrder[]
  paymentRefunds        PaymentRefund[]
  idempotencyKeys       IdempotencyKey[]
  carts                 Cart[]
  customerAddresses     CustomerAddress[]
  deliveryMethods       DeliveryMethod[]
  deliveryZones         DeliveryZone[]
  shipments             Shipment[]

  @@map("merchants")
}

model MerchantBranch {
  id               String               @id @default(uuid()) @db.Uuid
  merchantId       String               @db.Uuid
  name             String
  code             String
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  province         String?
  postalCode       String?
  country          String?
  registerName     String?
  isDefault        Boolean              @default(false)
  status           MerchantBranchStatus @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  merchant         Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  posDevices       PosDevice[]
  posShifts        PosShift[]
  posTables        PosTable[]
  orders           Order[]
  checkoutSessions CheckoutSession[]
  deliveryMethods  DeliveryMethod[]

  @@unique([merchantId, code])
  @@index([merchantId, status, deletedAt])
  @@index([merchantId, isDefault])
  @@map("merchant_branches")
}

model Product {
  id                 String                     @id @default(uuid()) @db.Uuid
  merchantId         String                     @db.Uuid
  categoryId         String?                    @db.Uuid
  name               String
  slug               String
  description        String?
  sku                String
  price              Decimal                    @db.Decimal(12, 2)
  currency           String                     @default("USD") @db.Char(3)
  status             ProductStatus              @default(DRAFT)
  type               ProductType                @default(SIMPLE)
  inventoryType      ProductInventoryType       @default(NON_STOCKED)
  trackStock         Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deletedAt          DateTime?
  merchant           Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category           ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  media              ProductMedia[]
  channelVisibility  ProductChannelVisibility[]
  inventoryStocks    InventoryStock[]
  reservations       InventoryReservation[]
  inventoryMovements InventoryMovement[]
  checkoutItems      CheckoutItem[]
  orderItems         OrderItem[]
  shoppableHotspots  ShoppableHotspot[]
  cartItems          CartItem[]

  @@unique([merchantId, sku])
  @@unique([merchantId, slug])
  @@unique([id, merchantId])
  @@index([merchantId, categoryId])
  @@index([merchantId, status, deletedAt])
  @@map("products")
}

model ProductCategory {
  id          String                @id @default(uuid()) @db.Uuid
  merchantId  String                @db.Uuid
  name        String
  slug        String
  description String?
  logoUrl     String?
  sortOrder   Int                   @default(0)
  status      ProductCategoryStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?
  merchant    Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([merchantId, slug])
  @@index([merchantId, status, deletedAt])
  @@index([merchantId, sortOrder])
  @@map("product_categories")
}

model MerchantTheme {
  id           String    @id @default(uuid()) @db.Uuid
  merchantId   String    @unique @db.Uuid
  liveConfig   Json
  draftConfig  Json
  customDomain String?   @unique
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_themes")
}

model ProductVariant {
  id                 String                 @id @default(uuid()) @db.Uuid
  productId          String                 @db.Uuid
  merchantId         String                 @db.Uuid
  sku                String
  name               String
  price              Decimal                @db.Decimal(12, 2)
  attributes         Json
  status             ProductVariantStatus   @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  product            Product                @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  inventoryStocks    InventoryStock[]
  reservations       InventoryReservation[]
  inventoryMovements InventoryMovement[]
  checkoutItems      CheckoutItem[]
  orderItems         OrderItem[]
  shoppableHotspots  ShoppableHotspot[]
  cartItems          CartItem[]

  @@unique([merchantId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @db.Uuid
  url       String
  type      ProductMediaType @default(IMAGE)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductChannelVisibility {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @db.Uuid
  channel       SalesChannel
  isVisible     Boolean      @default(false)
  isPurchasable Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([productId])
  @@map("product_channel_visibility")
}

model InventoryStock {
  id            String                 @id @default(uuid()) @db.Uuid
  merchantId    String                 @db.Uuid
  productId     String                 @db.Uuid
  variantId     String?                @db.Uuid
  stockKey      String
  totalStock    Int                    @default(0)
  reservedStock Int                    @default(0)
  soldStock     Int                    @default(0)
  safetyBuffer  Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  merchant      Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations  InventoryReservation[]
  movements     InventoryMovement[]

  @@unique([merchantId, stockKey])
  @@index([merchantId, productId])
  @@index([variantId])
  @@map("inventory_stocks")
}

model InventoryReservation {
  id                String                     @id @default(uuid()) @db.Uuid
  merchantId        String                     @db.Uuid
  inventoryStockId  String                     @db.Uuid
  productId         String                     @db.Uuid
  variantId         String?                    @db.Uuid
  orderId           String?                    @db.Uuid
  checkoutSessionId String                     @db.Uuid
  quantity          Int
  status            InventoryReservationStatus @default(ACTIVE)
  expiresAt         DateTime
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  merchant          Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  inventoryStock    InventoryStock             @relation(fields: [inventoryStockId], references: [id], onDelete: Restrict)
  product           Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant?            @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([checkoutSessionId, inventoryStockId])
  @@index([merchantId, status, expiresAt])
  @@index([orderId])
  @@map("inventory_reservations")
}

model CheckoutSession {
  id                 String                @id @default(uuid()) @db.Uuid
  merchantId         String                @db.Uuid
  branchId           String?               @db.Uuid
  posDeviceId        String?               @db.Uuid
  customerId         String?               @db.Uuid
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  sourceChannel      SalesChannel
  status             CheckoutSessionStatus @default(ACTIVE)
  accessTokenHash    String                @unique
  subtotalAmount     Decimal               @db.Decimal(12, 2)
  discountAmount     Decimal               @default(0) @db.Decimal(12, 2)
  feeAmount          Decimal               @default(0) @db.Decimal(12, 2)
  shippingAmount     Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal               @db.Decimal(12, 2)
  currency           String                @db.Char(3)
  deliveryMethodId   String?               @db.Uuid
  deliveryMethodName String?
  shippingAddress    Json?
  billingAddress     Json?
  expiresAt          DateTime
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  merchant           Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch             MerchantBranch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  posDevice          PosDevice?            @relation(fields: [posDeviceId], references: [id], onDelete: SetNull)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryMethod     DeliveryMethod?       @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  items              CheckoutItem[]
  order              Order?
  cart               Cart?

  @@index([merchantId, status, expiresAt])
  @@index([branchId])
  @@index([posDeviceId])
  @@map("checkout_sessions")
}

model CheckoutItem {
  id                String          @id @default(uuid()) @db.Uuid
  checkoutSessionId String          @db.Uuid
  productId         String          @db.Uuid
  variantId         String?         @db.Uuid
  sku               String
  name              String
  quantity          Int
  unitPrice         Decimal         @db.Decimal(12, 2)
  totalPrice        Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([checkoutSessionId])
  @@index([productId])
  @@index([variantId])
  @@map("checkout_items")
}

model Order {
  id                 String            @id @default(uuid()) @db.Uuid
  merchantId         String            @db.Uuid
  checkoutSessionId  String            @unique @db.Uuid
  branchId           String?           @db.Uuid
  posDeviceId        String?           @db.Uuid
  posShiftId         String?           @db.Uuid
  tableId            String?           @db.Uuid
  localId            String?
  customerId         String?           @db.Uuid
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  sourceChannel      SalesChannel
  orderNumber        String
  status             OrderStatus       @default(PENDING_PAYMENT)
  subtotalAmount     Decimal           @db.Decimal(12, 2)
  discountAmount     Decimal           @default(0) @db.Decimal(12, 2)
  feeAmount          Decimal           @default(0) @db.Decimal(12, 2)
  shippingAmount     Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal           @db.Decimal(12, 2)
  currency           String            @db.Char(3)
  deliveryMethodId   String?           @db.Uuid
  deliveryMethodName String?
  shippingAddress    Json?
  billingAddress     Json?
  paymentStatus      PaymentStatus     @default(PENDING)
  fulfillmentStatus  FulfillmentStatus @default(UNFULFILLED)
  paidAt             DateTime?
  fulfilledAt        DateTime?
  cancelledAt        DateTime?
  refundedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  merchant           Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkoutSession    CheckoutSession   @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  branch             MerchantBranch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  posDevice          PosDevice?        @relation(fields: [posDeviceId], references: [id], onDelete: SetNull)
  posShift           PosShift?         @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  table              PosTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryMethod     DeliveryMethod?   @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  kitchenOrders      KitchenOrder[]
  shipments          Shipment[]

  @@unique([merchantId, orderNumber])
  @@unique([merchantId, posDeviceId, localId])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, paymentStatus, fulfillmentStatus])
  @@index([branchId])
  @@index([posShiftId])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                    String             @id @default(uuid()) @db.Uuid
  orderId               String             @db.Uuid
  productId             String             @db.Uuid
  variantId             String?            @db.Uuid
  sku                   String
  name                  String
  quantity              Int
  unitPrice             Decimal            @db.Decimal(12, 2)
  totalPrice            Decimal            @db.Decimal(12, 2)
  note                  String?
  sentToKitchenQuantity Int                @default(0)
  preparedQuantity      Int                @default(0)
  cancelledQuantity     Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant               ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  kitchenOrderItems     KitchenOrderItem[]
  shipmentItems         ShipmentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model PaymentProvider {
  id            String                @id @default(uuid()) @db.Uuid
  merchantId    String                @db.Uuid
  provider      PaymentProviderCode
  config        Json
  status        PaymentProviderStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  merchant      Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payments      Payment[]
  webhookEvents PaymentWebhookEvent[]

  @@unique([merchantId, provider])
  @@index([merchantId, status])
  @@map("payment_providers")
}

model Payment {
  id                    String                   @id @default(uuid()) @db.Uuid
  merchantId            String                   @db.Uuid
  orderId               String                   @db.Uuid
  posShiftId            String?                  @db.Uuid
  paymentProviderId     String                   @db.Uuid
  provider              PaymentProviderCode
  providerTransactionId String                   @unique
  paymentReference      String?
  idempotencyKey        String?                  @unique
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String                   @db.Char(3)
  status                PaymentTransactionStatus @default(PENDING)
  metadata              Json?
  paidAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  merchant              Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  posShift              PosShift?                @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  paymentProvider       PaymentProvider          @relation(fields: [paymentProviderId], references: [id], onDelete: Restrict)
  webhookEvents         PaymentWebhookEvent[]
  refunds               PaymentRefund[]

  @@index([merchantId, status, createdAt])
  @@index([paymentProviderId])
  @@index([orderId])
  @@index([posShiftId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                String               @id @default(uuid()) @db.Uuid
  merchantId        String               @db.Uuid
  paymentProviderId String               @db.Uuid
  paymentId         String               @db.Uuid
  provider          PaymentProviderCode
  eventId           String
  payload           Json
  status            PaymentWebhookStatus @default(RECEIVED)
  error             String?
  processedAt       DateTime?
  createdAt         DateTime             @default(now())
  merchant          Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentProvider   PaymentProvider      @relation(fields: [paymentProviderId], references: [id], onDelete: Restrict)
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentProviderId, eventId])
  @@index([merchantId, status, createdAt])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model PaymentRefund {
  id                          String              @id @default(uuid()) @db.Uuid
  merchantId                  String              @db.Uuid
  paymentId                   String              @db.Uuid
  orderId                     String              @db.Uuid
  amount                      Decimal             @db.Decimal(12, 2)
  reason                      String?
  status                      PaymentRefundStatus @default(PENDING)
  providerRefundTransactionId String?             @unique
  idempotencyKey              String?             @unique
  returnedStock               Boolean             @default(false)
  requestedById               String              @db.Uuid
  approvedById                String?             @db.Uuid
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  merchant                    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment                     Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([merchantId, paymentId])
  @@index([orderId])
  @@map("payment_refunds")
}

model PosDevice {
  id               String            @id @default(uuid()) @db.Uuid
  merchantId       String            @db.Uuid
  branchId         String            @db.Uuid
  deviceId         String
  name             String?
  platform         String?
  appVersion       String?
  status           PosDeviceStatus   @default(ACTIVE)
  lastSeenAt       DateTime?
  registeredById   String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch           MerchantBranch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shifts           PosShift[]
  orders           Order[]
  checkoutSessions CheckoutSession[]

  @@unique([merchantId, deviceId])
  @@index([merchantId, branchId, status])
  @@map("pos_devices")
}

model PosShift {
  id             String         @id @default(uuid()) @db.Uuid
  merchantId     String         @db.Uuid
  branchId       String         @db.Uuid
  posDeviceId    String         @db.Uuid
  openedById     String         @db.Uuid
  closedById     String?        @db.Uuid
  status         PosShiftStatus @default(OPEN)
  openingCash    Decimal        @db.Decimal(12, 2)
  closingCash    Decimal?       @db.Decimal(12, 2)
  expectedCash   Decimal?       @db.Decimal(12, 2)
  cashDifference Decimal?       @db.Decimal(12, 2)
  note           String?
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  merchant       Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
