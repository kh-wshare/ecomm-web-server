generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MerchantUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MerchantBranchStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum ProductInventoryType {
  STOCKED
  NON_STOCKED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum SalesChannel {
  POS
  WEBSITE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum InventoryReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVED
  RESERVATION_RELEASED
  SOLD
  REFUND_RETURN
  MANUAL_ADJUSTMENT
}

enum CheckoutSessionStatus {
  ACTIVE
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  RESERVED
  PAID
  PROCESSING
  FULFILLED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentProviderCode {
  HMAC
  KHQR
  ABA_PAYWAY
  CASH
}

enum PaymentProviderStatus {
  ACTIVE
  INACTIVE
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  UNKNOWN
}

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum SocialPlatform {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum SocialPostStatus {
  DRAFT
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum SocialPublishStatus {
  PUBLISHED
  FAILED
}

enum PosDeviceStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum KitchenOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentRefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  /// Folded into another cart when a guest signed in and their two carts
  /// were combined; `mergedIntoCartId` points at the survivor.
  MERGED
  ABANDONED
  EXPIRED
}

enum LoyaltyEntryType {
  EARNED
  REVERSED
  ADJUSTED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum DeliveryMethodType {
  PICKUP
  DELIVERY
}

enum DeliveryMethodStatus {
  ACTIVE
  INACTIVE
}

enum ShipmentStatus {
  PENDING
  READY_FOR_PICKUP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  fullName            String               @map("full_name")
  email               String?              @unique
  phone               String?
  telegramId          String?              @unique @map("telegram_id")
  passwordHash        String               @map("password_hash")
  status              UserStatus           @default(ACTIVE)
  platformRole        PlatformRole         @default(USER) @map("platform_role")
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  memberships         MerchantUser[]       @relation("MembershipUser")
  invitedMemberships  MerchantUser[]       @relation("MembershipInviter")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     MerchantInvitation[] @relation("InvitationInviter")
  auditLogs           AuditLog[]
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementCreator")
  authIdentities      AuthIdentity[]
  ownedAddresses      CustomerAddress[]    @relation("AddressOwner")
  createdAddresses    CustomerAddress[]    @relation("AddressCreator")
  ownedCarts          Cart[]               @relation("CartOwner")
  createdCarts        Cart[]               @relation("CartCreator")

  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  telegramId     String?  @unique @map("telegram_id")
  email          String?
  phone          String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Merchant {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String                 @unique
  email                 String?
  phone                 String?
  status                MerchantStatus         @default(ACTIVE)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  memberships           MerchantUser[]
  roles                 Role[]
  sessions              Session[]
  invitations           MerchantInvitation[]
  auditLogs             AuditLog[]
  products              Product[]
  inventoryStocks       InventoryStock[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  theme                 MerchantTheme?
  checkoutSessions      CheckoutSession[]
  orders                Order[]
  returnStockOnRefund   Boolean                @default(true) @map("return_stock_on_refund")
  /// Loyalty is off until a merchant turns it on, so existing merchants are
  /// unaffected and nobody accrues a balance they never advertised.
  loyaltyEnabled        Boolean                @default(false) @map("loyalty_enabled")
  /// Points granted per whole currency unit of an order's paid subtotal.
  loyaltyPointsPerUnit  Int                    @default(1) @map("loyalty_points_per_unit")
  loyaltyEntries        LoyaltyLedgerEntry[]
  paymentProviders      PaymentProvider[]
  payments              Payment[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  notifications         Notification[]
  socialPosts           SocialPost[]
  websiteArticles       WebsiteArticle[]
  branches              MerchantBranch[]
  productCategories     ProductCategory[]
  posDevices            PosDevice[]
  posShifts             PosShift[]
  posTables             PosTable[]
  customers             Customer[]
  kitchenOrders         KitchenOrder[]
  paymentRefunds        PaymentRefund[]
  idempotencyKeys       IdempotencyKey[]
  carts                 Cart[]
  customerAddresses     CustomerAddress[]
  deliveryMethods       DeliveryMethod[]
  deliveryZones         DeliveryZone[]
  shipments             Shipment[]

  @@map("merchants")
}

model MerchantBranch {
  id               String               @id @default(uuid()) @db.Uuid
  merchantId       String               @map("merchant_id") @db.Uuid
  name             String
  code             String
  phone            String?
  addressLine1     String?              @map("address_line1")
  addressLine2     String?              @map("address_line2")
  city             String?
  province         String?
  postalCode       String?              @map("postal_code")
  country          String?
  registerName     String?              @map("register_name")
  isDefault        Boolean              @default(false) @map("is_default")
  status           MerchantBranchStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  merchant         Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  posDevices       PosDevice[]
  posShifts        PosShift[]
  posTables        PosTable[]
  orders           Order[]
  checkoutSessions CheckoutSession[]
  deliveryMethods  DeliveryMethod[]

  @@unique([merchantId, code])
  @@index([merchantId, status, deletedAt])
  @@index([merchantId, isDefault])
  @@map("merchant_branches")
}

model Product {
  id                 String                     @id @default(uuid()) @db.Uuid
  merchantId         String                     @map("merchant_id") @db.Uuid
  categoryId         String?                    @map("category_id") @db.Uuid
  name               String
  slug               String
  description        String?
  sku                String
  price              Decimal                    @db.Decimal(12, 2)
  currency           String                     @default("USD") @db.Char(3)
  status             ProductStatus              @default(DRAFT)
  type               ProductType                @default(SIMPLE)
  inventoryType      ProductInventoryType       @default(NON_STOCKED) @map("inventory_type")
  trackStock         Boolean                    @default(false) @map("track_stock")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  deletedAt          DateTime?                  @map("deleted_at")
  merchant           Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category           ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  media              ProductMedia[]
  channelVisibility  ProductChannelVisibility[]
  inventoryStocks    InventoryStock[]
  reservations       InventoryReservation[]
  inventoryMovements InventoryMovement[]
  checkoutItems      CheckoutItem[]
  orderItems         OrderItem[]
  shoppableHotspots  ShoppableHotspot[]
  cartItems          CartItem[]

  @@unique([merchantId, sku])
  @@unique([merchantId, slug])
  @@unique([id, merchantId])
  @@index([merchantId, categoryId])
  @@index([merchantId, status, deletedAt])
  @@map("products")
}

model ProductCategory {
  id          String                @id @default(uuid()) @db.Uuid
  merchantId  String                @map("merchant_id") @db.Uuid
  name        String
  slug        String
  description String?
  logoUrl     String?               @map("logo_url")
  sortOrder   Int                   @default(0) @map("sort_order")
  status      ProductCategoryStatus @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")
  merchant    Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([merchantId, slug])
  @@index([merchantId, status, deletedAt])
  @@index([merchantId, sortOrder])
  @@map("product_categories")
}

model MerchantTheme {
  id           String    @id @default(uuid()) @db.Uuid
  merchantId   String    @unique @map("merchant_id") @db.Uuid
  liveConfig   Json      @map("live_config")
  draftConfig  Json      @map("draft_config")
  customDomain String?   @unique @map("custom_domain")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_themes")
}

model ProductVariant {
  id                 String                 @id @default(uuid()) @db.Uuid
  productId          String                 @map("product_id") @db.Uuid
  merchantId         String                 @map("merchant_id") @db.Uuid
  sku                String
  name               String
  price              Decimal                @db.Decimal(12, 2)
  attributes         Json
  status             ProductVariantStatus   @default(ACTIVE)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  product            Product                @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  inventoryStocks    InventoryStock[]
  reservations       InventoryReservation[]
  inventoryMovements InventoryMovement[]
  checkoutItems      CheckoutItem[]
  orderItems         OrderItem[]
  shoppableHotspots  ShoppableHotspot[]
  cartItems          CartItem[]

  @@unique([merchantId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @map("product_id") @db.Uuid
  url       String
  type      ProductMediaType @default(IMAGE)
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductChannelVisibility {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  channel       SalesChannel
  isVisible     Boolean      @default(false) @map("is_visible")
  isPurchasable Boolean      @default(false) @map("is_purchasable")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([productId])
  @@map("product_channel_visibility")
}

model InventoryStock {
  id            String                 @id @default(uuid()) @db.Uuid
  merchantId    String                 @map("merchant_id") @db.Uuid
  productId     String                 @map("product_id") @db.Uuid
  variantId     String?                @map("variant_id") @db.Uuid
  stockKey      String                 @map("stock_key")
  totalStock    Int                    @default(0) @map("total_stock")
  reservedStock Int                    @default(0) @map("reserved_stock")
  soldStock     Int                    @default(0) @map("sold_stock")
  safetyBuffer  Int                    @default(0) @map("safety_buffer")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  merchant      Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations  InventoryReservation[]
  movements     InventoryMovement[]

  @@unique([merchantId, stockKey])
  @@index([merchantId, productId])
  @@index([variantId])
  @@map("inventory_stocks")
}

model InventoryReservation {
  id                String                     @id @default(uuid()) @db.Uuid
  merchantId        String                     @map("merchant_id") @db.Uuid
  inventoryStockId  String                     @map("inventory_stock_id") @db.Uuid
  productId         String                     @map("product_id") @db.Uuid
  variantId         String?                    @map("variant_id") @db.Uuid
  orderId           String?                    @map("order_id") @db.Uuid
  checkoutSessionId String                     @map("checkout_session_id") @db.Uuid
  quantity          Int
  status            InventoryReservationStatus @default(ACTIVE)
  expiresAt         DateTime                   @map("expires_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  merchant          Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  inventoryStock    InventoryStock             @relation(fields: [inventoryStockId], references: [id], onDelete: Restrict)
  product           Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant?            @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([checkoutSessionId, inventoryStockId])
  @@index([merchantId, status, expiresAt])
  @@index([orderId])
  @@map("inventory_reservations")
}

model CheckoutSession {
  id                 String                @id @default(uuid()) @db.Uuid
  merchantId         String                @map("merchant_id") @db.Uuid
  branchId           String?               @map("branch_id") @db.Uuid
  posDeviceId        String?               @map("pos_device_id") @db.Uuid
  customerId         String?               @map("customer_id") @db.Uuid
  /// The signed-in shopper who checked out, when there was one. Carried from
  /// the cart onto the Order so loyalty can tell an account order from a
  /// guest order that merely typed a known email.
  ownerId            String?               @map("owner_id") @db.Uuid
  customerName       String?               @map("customer_name")
  customerEmail      String?               @map("customer_email")
  customerPhone      String?               @map("customer_phone")
  sourceChannel      SalesChannel          @map("source_channel")
  status             CheckoutSessionStatus @default(ACTIVE)
  accessTokenHash    String                @unique @map("access_token_hash")
  subtotalAmount     Decimal               @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount     Decimal               @default(0) @map("discount_amount") @db.Decimal(12, 2)
  feeAmount          Decimal               @default(0) @map("fee_amount") @db.Decimal(12, 2)
  shippingAmount     Decimal               @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount        Decimal               @map("total_amount") @db.Decimal(12, 2)
  currency           String                @db.Char(3)
  deliveryMethodId   String?               @map("delivery_method_id") @db.Uuid
  deliveryMethodName String?               @map("delivery_method_name")
  shippingAddress    Json?                 @map("shipping_address")
  billingAddress     Json?                 @map("billing_address")
  expiresAt          DateTime              @map("expires_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  merchant           Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch             MerchantBranch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  posDevice          PosDevice?            @relation(fields: [posDeviceId], references: [id], onDelete: SetNull)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryMethod     DeliveryMethod?       @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  items              CheckoutItem[]
  order              Order?
  cart               Cart?

  @@index([merchantId, status, expiresAt])
  @@index([branchId])
  @@index([posDeviceId])
  @@map("checkout_sessions")
}

model CheckoutItem {
  id                String          @id @default(uuid()) @db.Uuid
  checkoutSessionId String          @map("checkout_session_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  variantId         String?         @map("variant_id") @db.Uuid
  sku               String
  name              String
  quantity          Int
  unitPrice         Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice        Decimal         @map("total_price") @db.Decimal(12, 2)
  createdAt         DateTime        @default(now()) @map("created_at")
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([checkoutSessionId])
  @@index([productId])
  @@index([variantId])
  @@map("checkout_items")
}

model Order {
  id                 String               @id @default(uuid()) @db.Uuid
  merchantId         String               @map("merchant_id") @db.Uuid
  checkoutSessionId  String               @unique @map("checkout_session_id") @db.Uuid
  branchId           String?              @map("branch_id") @db.Uuid
  posDeviceId        String?              @map("pos_device_id") @db.Uuid
  posShiftId         String?              @map("pos_shift_id") @db.Uuid
  tableId            String?              @map("table_id") @db.Uuid
  localId            String?              @map("local_id")
  customerId         String?              @map("customer_id") @db.Uuid
  /// The signed-in shopper who placed this order, when there was one.
  ownerId            String?              @map("owner_id") @db.Uuid
  customerName       String?              @map("customer_name")
  customerEmail      String?              @map("customer_email")
  customerPhone      String?              @map("customer_phone")
  sourceChannel      SalesChannel         @map("source_channel")
  orderNumber        String               @map("order_number")
  status             OrderStatus          @default(PENDING_PAYMENT)
  subtotalAmount     Decimal              @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  feeAmount          Decimal              @default(0) @map("fee_amount") @db.Decimal(12, 2)
  shippingAmount     Decimal              @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount        Decimal              @map("total_amount") @db.Decimal(12, 2)
  currency           String               @db.Char(3)
  deliveryMethodId   String?              @map("delivery_method_id") @db.Uuid
  deliveryMethodName String?              @map("delivery_method_name")
  shippingAddress    Json?                @map("shipping_address")
  billingAddress     Json?                @map("billing_address")
  paymentStatus      PaymentStatus        @default(PENDING) @map("payment_status")
  fulfillmentStatus  FulfillmentStatus    @default(UNFULFILLED) @map("fulfillment_status")
  paidAt             DateTime?            @map("paid_at")
  fulfilledAt        DateTime?            @map("fulfilled_at")
  cancelledAt        DateTime?            @map("cancelled_at")
  refundedAt         DateTime?            @map("refunded_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  merchant           Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkoutSession    CheckoutSession      @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  branch             MerchantBranch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  posDevice          PosDevice?           @relation(fields: [posDeviceId], references: [id], onDelete: SetNull)
  posShift           PosShift?            @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  table              PosTable?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer           Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryMethod     DeliveryMethod?      @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  kitchenOrders      KitchenOrder[]
  shipments          Shipment[]
  loyaltyEntries     LoyaltyLedgerEntry[]

  @@unique([merchantId, orderNumber])
  @@unique([merchantId, posDeviceId, localId])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, paymentStatus, fulfillmentStatus])
  @@index([branchId])
  @@index([posShiftId])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                    String             @id @default(uuid()) @db.Uuid
  orderId               String             @map("order_id") @db.Uuid
  productId             String             @map("product_id") @db.Uuid
  variantId             String?            @map("variant_id") @db.Uuid
  sku                   String
  name                  String
  quantity              Int
  unitPrice             Decimal            @map("unit_price") @db.Decimal(12, 2)
  totalPrice            Decimal            @map("total_price") @db.Decimal(12, 2)
  note                  String?
  sentToKitchenQuantity Int                @default(0) @map("sent_to_kitchen_quantity")
  preparedQuantity      Int                @default(0) @map("prepared_quantity")
  cancelledQuantity     Int                @default(0) @map("cancelled_quantity")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant               ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  kitchenOrderItems     KitchenOrderItem[]
  shipmentItems         ShipmentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model PaymentProvider {
  id            String                @id @default(uuid()) @db.Uuid
  merchantId    String                @map("merchant_id") @db.Uuid
  provider      PaymentProviderCode
  config        Json
  status        PaymentProviderStatus @default(ACTIVE)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  merchant      Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
