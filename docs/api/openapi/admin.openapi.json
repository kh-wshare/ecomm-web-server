  "info": {
    "title": "Admin API",
    "description": "Internal platform administration; separate from merchant admin roles",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "fullName": {
            "type": "string",
            "example": "Jane Doe"
          },
          "password": {
            "type": "string",
            "example": "StrongPassword123!",
            "minLength": 10
          },
          "platformRole": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "default": "USER"
          }
        },
        "required": [
          "email",
          "fullName",
          "password"
        ]
      }
    }
  }
}
