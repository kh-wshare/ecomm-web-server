  "info": {
    "title": "User API",
    "description": "Authentication, sessions, profiles, and merchant access",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "merchantName": {
            "type": "string",
            "example": "Acme Store"
          },
          "fullName": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "StrongPassword123!",
            "minLength": 10
          },
          "phone": {
            "type": "string",
            "example": "+15551234567"
          }
        },
        "required": [
          "merchantName",
          "fullName",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "strongPassword123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SwitchMerchantDto": {
        "type": "object",
        "properties": {
          "merchantId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "merchantId"
        ]
      },
      "FirebaseGoogleLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Firebase Authentication ID token from Google sign-in"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "TelegramLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Telegram Login OIDC ID token returned by telegram-login.js"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "TelegramTokenExchangeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Authorization code returned by Telegram OAuth"
          },
          "codeVerifier": {
            "type": "string",
            "description": "PKCE code verifier generated before authorization"
          },
          "redirectUri": {
            "type": "string",
            "description": "Redirect URI used for the Telegram authorization request"
          }
        },
        "required": [
          "code",
          "codeVerifier",
          "redirectUri"
        ]
      },
      "TelegramMiniAppLoginDto": {
        "type": "object",
        "properties": {
          "initData": {
            "type": "string",
            "description": "Raw Telegram.WebApp.initData string from the Mini App (never initDataUnsafe)"
          }
        },
        "required": [
          "initData"
        ]
      }
    }
  }
}
