{
  "name": "merchant-commerce-client",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=./apps/*",
    "build": "turbo build --filter=./apps/* --filter=./packages/*",
    "lint": "turbo lint --filter=@repo/marketing --filter=@repo/merchant --filter=@repo/pos --filter=@repo/storefront",
    "type-check": "turbo type-check --filter=./apps/* --filter=./packages/*",
    "merchant:dev": "pnpm --filter @repo/merchant dev",
    "marketing:dev": "pnpm --filter @repo/marketing dev",
    "pos:dev": "pnpm --filter @repo/pos dev",
    "storefront:dev": "pnpm --filter @repo/storefront dev"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  }
}
