# Copy to .env and fill in real values before running anywhere near
# production. This mirrors the root .env.example (the full app config
# surface — see src/config/config.module.ts); DATABASE_URL/REDIS_HOST/
# REDIS_PORT below are overridden in docker-compose.yml for the container
# network and don't need to be set here.

# --- App -----------------------------------------------------------------
APP_NAME=Merchant Commerce Hub
APP_PREFIX=api

# --- Postgres --------------------------------------------------------------
DB_USER=dev_user
DB_PASSWORD=soklay512
DB_NAME=dev_db
DB_PORT=5433

# --- Redis -------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT -----------------------------------------------------------------
# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-insecure-access-secret-change-me
JWT_REFRESH_SECRET=dev-insecure-refresh-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Payment provider ------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Object/file storage -----------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/files
STORAGE_MAX_FILE_SIZE_BYTES=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,application/pdf
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=merchant-hub

# --- Frontends -------------------------------------------------------------
DASHBOARD_FRONTEND_URL=http://localhost/merchant
PUBLIC_STOREFRONT_URL=http://localhost

# --- Social login ------------------------------------------------------
FIREBASE_PROJECT_ID=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_ISSUER=https://oauth.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE=86400

# --- Swagger (platform-admin docs default to disabled in production) -------
SWAGGER_ENABLED=true
SWAGGER_USER_ENABLED=true
SWAGGER_MERCHANT_ENABLED=true
SWAGGER_POS_ENABLED=true
SWAGGER_STOREFRONT_ENABLED=true
SWAGGER_ADMIN_ENABLED=false

# --- Host port mappings ----------------------------------------------------
PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
