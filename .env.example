# App
PORT=9001
NODE_ENV=development

# Database (PostgreSQL)
DB_USER=dev_user
DB_PASSWORD=soklay512
DB_NAME=dev_db
DB_PORT=5448
DATABASE_URL="postgresql://dev_user:soklay512@localhost:5448/dev_db?schema=public"

# Redis
REDIS_URL=redis://localhost:6388
REDIS_HOST=localhost
REDIS_PORT=6388
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Payment provider
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# Object/file storage
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:9001/files
STORAGE_MAX_FILE_SIZE_BYTES=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,application/pdf
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=merchant-hub

# Frontends
DASHBOARD_FRONTEND_URL=http://localhost:3000
PUBLIC_STOREFRONT_URL=http://localhost:3002

# Social login
FIREBASE_PROJECT_ID=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_ISSUER=https://oauth.telegram.org

# Telegram Mini App login (initData HMAC verification)
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE=86400

# Swagger (platform-admin docs default to disabled in production)
SWAGGER_ENABLED=true
SWAGGER_USER_ENABLED=true
SWAGGER_MERCHANT_ENABLED=true
SWAGGER_POS_ENABLED=true
SWAGGER_STOREFRONT_ENABLED=true
SWAGGER_ADMIN_ENABLED=false
